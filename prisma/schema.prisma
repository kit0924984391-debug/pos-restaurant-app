generator client {
  provider   = "prisma-client-js"
  engineType = "client"
  runtime    = "workerd"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 1. ระบบจัดการแพลตฟอร์ม & สมาชิก (Platform & SaaS Auth)
// ----------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("STORE_OWNER") // SUPER_ADMIN, STORE_OWNER, STORE_STAFF
  storeId      String?
  store        Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // กระดานสนทนา (Community Board)
  boardThreads   BoardThread[]
  boardComments  BoardComment[]
  boardReactions BoardReaction[]
  boardReports   BoardReport[]
}

model Store {
  id              String         @id @default(cuid())
  slug            String         @unique // เช่น "lung-pa", "zaab-cafe"
  name            String         // เช่น "ร้านอาหารตามสั่ง ลุง-ป้า"
  description     String?
  status          String         @default("TRIAL") // TRIAL, ACTIVE, PENDING_PAYMENT, SUSPENDED, EXPIRED
  trialEndsAt     DateTime
  subscriptionEnd DateTime
  planId          String?
  plan            Plan?          @relation(fields: [planId], references: [id])
  
  // การตั้งค่าร้านค้า & บัญชีรับเงินของร้านนั้นๆ
  promptPayId     String         @default("")
  promptPayName   String         @default("")
  phone           String?
  address         String?
  receiptFooter   String?        @default("ขอบคุณที่อุดหนุนครับ/ค่ะ โอกาสหน้าเชิญใหม่")
  tableCount      Int            @default(10)
  
  // การตั้งค่าระบบสมาชิกสะสมแต้ม (Loyalty Points Settings)
  pointsRate      Float          @default(25) // ยอดซื้อทุกกี่บาท = 1 แต้ม (ค่าเริ่มต้น 25 บ.)
  pointValue      Float          @default(1)  // 1 แต้ม = แลกส่วนลดได้กี่บาท (ค่าเริ่มต้น 1 บ.)
  
  // การตั้งค่าเดลิเวอรี & ค่าคอมมิชชั่น GP (Delivery Platforms & GP Settings)
  linemanGp       Float          @default(30) // % GP LINE MAN
  grabGp          Float          @default(30) // % GP GrabFood
  shopeeGp        Float          @default(30) // % GP ShopeeFood
  robinhoodGp     Float          @default(20) // % GP Robinhood
  deliveryWebhookSecret String?  // Webhook Security Token for Platform API

  // การตั้งค่าระบบสแกนและอ่านสลิปโอนเงิน (Slip Verification Settings)
  slipAutoCheckout Boolean       @default(false) // ปิดบิลและเคลียร์โต๊ะอัตโนมัติเมื่อสลิปผ่าน
  slipProvider     String        @default("HYBRID") // HYBRID, INTERNAL, SLIPOK, EASYSLIP
  slipApiKey       String?       // API Key สำหรับ SlipOK / EasySlip
  slipBranchId     String?       // Branch ID สำหรับ SlipOK
  
  // การตั้งค่าระบบรับแจ้งเตือนเงินเข้าอัตโนมัติ (LINE / Bank Webhook Settings)
  bankWebhookKey   String?       // Secret Token สำหรับยืนยันความปลอดภัย Webhook ประจำร้าน
  bankAutoCheckout Boolean       @default(true) // ปิดบิลอัตโนมัติเมื่อยอดเงินตรงกับบิลโต๊ะอาหาร
  
  // การตั้งค่าจัดเก็บสลิปบน Google Drive (Google Drive Slip Storage)
  googleDriveFolderId   String?  // Folder ID ใน Google Drive สำหรับเก็บรูปสลิป
  googleDriveWebhookUrl String?  // Webhook URL (Google Apps Script) สำหรับอัปโหลดตรงเข้า Drive
  
  // การตั้งค่าปุ่มเรียกพนักงานจากโต๊ะลูกค้า (Service Call Items)
  serviceCallItems      String?  // JSON string: [{ id, icon, label, active }]
  
  // การตั้งค่าเครื่องพิมพ์ความร้อน & พิมพ์ออเดอร์เข้าครัวอัตโนมัติ (Thermal Printer & Auto Print)
  autoPrintKitchenTicket Boolean @default(false) // พิมพ์ใบสั่งอาหารเข้าครัวอัตโนมัติเมื่อมีออเดอร์เข้า
  printerPaperWidth     String  @default("80mm") // ขนาดหน้ากว้างกระดาษความร้อน ("80mm" หรือ "58mm")
  enableAiUpsell        Boolean @default(true) // เปิด/ปิดระบบ AI แนะนำเมนูคู่กัน (AI Smart Upselling)
  
  // ความสัมพันธ์ข้อมูลของร้าน
  users           User[]
  categories      Category[]
  menuItems       MenuItem[]
  tables          Table[]
  orders          Order[]
  subscriptions   SubscriptionHistory[]
  ingredients     Ingredient[]
  stockLogs       StockLog[]
  members         CustomerMember[]
  promotions      Promotion[]
  rewards         LoyaltyReward[]
  bankNotifications BankNotificationLog[]
  
  // กำหนดเวลาลบร้านค้า & ป้องกันข้อมูลสูญหาย (Soft Delete & 30-Day Grace Period)
  scheduledDeleteAt DateTime?
  deletedAt         DateTime?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Plan {
  id           String                @id @default(cuid())
  name         String                // เช่น "Basic รายเดือน (1 เดือน)", "Pro (6 เดือน)", "Unlimited รายปี (1 ปี)"
  price        Float                 @default(0) // ราคาแพ็กเกจ (บาท)
  durationDays Int                   @default(30)
  maxTables    Int                   @default(15)
  description  String?
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  stores       Store[]
  subscriptions SubscriptionHistory[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model SubscriptionHistory {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id])
  amount     Float
  slipUrl    String?   // สลิปหลักฐานโอนเงิน
  note       String?
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt DateTime?
  approvedBy String?   // ชื่อหรือ ID ของ Super Admin
  createdAt  DateTime  @default(now())
}

model PlatformSetting {
  id              String   @id @default("default")
  platformName    String   @default("ORDEO SaaS POS")
  bankName        String   @default("ธนาคารกสิกรไทย (KBANK)")
  bankAccountNo   String   @default("123-4-56789-0")
  bankAccountName String   @default("บจก. ออร์เดียโอ โซลูชั่นส์")
  promptPayId     String   @default("0812345678")
  contactLine     String   @default("@ordeopos")
  contactPhone    String   @default("081-234-5678")
  updatedAt       DateTime @updatedAt
}

// ----------------------------------------------------
// 2. ข้อมูลเฉพาะของแต่ละร้าน (Tenant Scoped Models)
// ----------------------------------------------------

model Table {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableNo          Int      // โต๊ะหมายเลข 1, 2, 3...
  name             String   // "โต๊ะ 1", "VIP 1"
  status           String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, PAYMENT_PENDING
  currentSessionId String?
  updatedAt        DateTime @updatedAt
  orders           Order[]

  @@unique([storeId, tableNo])
}

model Category {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String     // เช่น "ผัดกะเพรา / ผัดพริกแกง", "ข้าวผัด", "เครื่องดื่ม"
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  basePrice   Float             @default(50)
  imageUrl    String?
  isAvailable Boolean           @default(true) // สำหรับปุ่ม 1-click "ของหมด"
  sortOrder   Int               @default(0)
  options     MenuOptionGroup[]
  orderItems  OrderItem[]
  recipes     MenuItemRecipe[]
}

model MenuOptionGroup {
  id         String             @id @default(cuid())
  menuItemId String
  menuItem   MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  title      String             // เช่น "เลือกเนื้อสัตว์", "เพิ่มไข่", "ระดับความเผ็ด"
  isRequired Boolean            @default(false)
  isMulti    Boolean            @default(false)
  choices    MenuOptionChoice[]
}

model MenuOptionChoice {
  id            String          @id @default(cuid())
  optionGroupId String
  optionGroup   MenuOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name          String          // เช่น "หมูกรอบ", "ไข่ดาวไม่สุก", "เผ็ดมาก"
  extraPrice    Float           @default(0)
}

// ----------------------------------------------------
// 3. ระบบคลังวัตถุดิบ & สูตรอาหาร (Inventory & Recipe BOM)
// ----------------------------------------------------

model Ingredient {
  id            String           @id @default(cuid())
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String           // เช่น "หมูสับ", "เนื้อวัว", "ไข่ไก่", "ใบกะเพรา", "ข้าวสาร", "พริกสด"
  unit          String           // เช่น "กรัม (g)", "ฟอง", "มล. (ml)", "กิโลกรัม (kg)"
  costPerUnit   Float            @default(0) // ต้นทุนต่อหน่วย (บาท)
  currentStock  Float            @default(0) // จำนวนคงเหลือ
  minStockAlert Float            @default(10) // เกณฑ์เตือนของใกล้หมด
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  recipes       MenuItemRecipe[]
  stockLogs     StockLog[]
}

model MenuItemRecipe {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float      @default(1) // ปริมาณที่ใช้ต่อ 1 จาน (เช่น 150g, 1 ฟอง)

  @@unique([menuItemId, ingredientId])
}

model StockLog {
  id           String     @id @default(cuid())
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  changeQty    Float      // เช่น +5000 (รับเข้า) หรือ -150 (ขาย)
  reason       String     // STOCK_IN, ORDER, ADJUST, SPOILAGE
  cost         Float?
  note         String?
  createdAt    DateTime   @default(now())
}

// ----------------------------------------------------
// 4. ระบบสมาชิกสะสมแต้ม & คูปองโปรโมชั่น (Loyalty CRM & Promo)
// ----------------------------------------------------

model CustomerMember {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  phone      String   // เบอร์โทรศัพท์สำหรับสะสมแต้ม
  name       String?  // ชื่อลูกค้า
  points     Int      @default(0) // แต้มสะสมคงเหลือ
  totalSpent Float    @default(0) // ยอดซื้อสะสมรวมทั้งหมด
  visitCount Int      @default(0) // จำนวนครั้งที่มาใช้บริการ
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([storeId, phone])
}

model Promotion {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String    // เช่น "WELCOME50", "DISC10"
  title         String    // เช่น "ส่วนลดเปิดร้านใหม่ 50 บาท"
  discountType  String    @default("FIXED") // FIXED (บาท), PERCENT (%)
  discountValue Float     // เช่น 50 หรือ 10
  minSpend      Float     @default(0) // ยอดสั่งซื้อขั้นต่ำ
  isActive      Boolean   @default(true)
  expiryDate    DateTime?
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, code])
}

model LoyaltyReward {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String    // เช่น "ฟรี ไข่ดาว 1 ฟอง", "ส่วนลดเงินสด 50 บาท", "ฟรีกะเพราหมูกรอบ"
  pointsRequired Int       // เช่น 10, 20, 50
  rewardType     String    @default("DISCOUNT") // "DISCOUNT", "FREE_ITEM"
  discountAmount Float     @default(0) // สำหรับ rewardType === "DISCOUNT" เช่น 50 บาท
  freeMenuItemId String?   // สำหรับ rewardType === "FREE_ITEM"
  description    String?
  isActive       Boolean   @default(true)
  usageCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ----------------------------------------------------
// 5. ออเดอร์และรายการสั่งอาหาร (Orders & Order Items)
// ----------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableId        String?
  table          Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableNo        Int         @default(1)
  status         String      @default("PENDING") // PENDING, COOKING, READY, SERVED, COMPLETED, CANCELLED
  orderType      String      @default("DINE_IN") // DINE_IN, TAKEAWAY
  orderChannel   String      @default("DINE_IN") // DINE_IN, TAKEAWAY, LINEMAN, GRAB, SHOPEE_FOOD, ROBINHOOD
  deliveryOrderId String?    // รหัสออเดอร์จากแอปเดลิเวอรี เช่น "LM-8492", "GF-1049"
  riderName      String?     // ชื่อคนขับ/ไรเดอร์
  riderPhone     String?     // เบอร์โทรคนขับ
  
  totalAmount    Float       @default(0)
  discountAmount Float       @default(0)
  netAmount      Float       @default(0)
  gpPercent      Float       @default(0) // % GP ที่ถูกหัก เช่น 30
  gpAmount       Float       @default(0) // ยอดเงินค่า GP เช่น 45 บาท
  netRevenue     Float       @default(0) // รายได้สุทธิที่ร้านได้รับจริงหลังหัก GP
  costAmount     Float       @default(0) // ต้นทุนวัตถุดิบรวมสำหรับคำนวณกำไร COGS
  
  // การสะสมแต้ม & ส่วนลดโปรโมชั่น
  memberPhone    String?
  pointsEarned   Int         @default(0)
  pointsRedeemed Int         @default(0)
  promoCode      String?
  
  paymentMethod  String?     // CASH, PROMPTPAY
  paymentStatus  String      @default("UNPAID") // UNPAID, PENDING_CONFIRMATION, PAID
  slipUrl        String?     // รูปภาพสลิปที่ลูกค้าหรือแคชเชียร์แนบ
  slipRef        String?     // รหัสอ้างอิงของสลิป (TransRef / Hash) เพื่อตรวจสลิปซ้ำ
  slipAmount     Float?      // ยอดเงินที่ตรวจพบบนสลิป
  slipVerifiedAt DateTime?   // เวลาที่ตรวจสลิปสำเร็จ
  slipVerifiedBy String?     // ผู้ตรวจสอบ เช่น AUTO, MANUAL, SYSTEM
  slipRawData    String?     // JSON บันทึกข้อมูลผลการอ่านสลิป
  cashReceived   Float?
  changeAmount   Float?
  customerLineId String?
  customerName   String?
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  paidAt         DateTime?
  items          OrderItem[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String?
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name            String
  price           Float
  quantity        Int      @default(1)
  selectedOptions String?  // JSON text: e.g. [{"group":"เนื้อสัตว์","choice":"หมูกรอบ","extra":15}]
  specialNote     String?  // เช่น "ไม่ใส่ผัก ไม่ใส่ชูรส"
  status          String   @default("PENDING") // PENDING, COOKING, READY, SERVED
  createdAt       DateTime @default(now())
}

model BankNotificationLog {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rawText        String   // ข้อความแจ้งเตือนเต็มจาก LINE / ธนาคาร
  sender         String?  // แหล่งที่มา เช่น SCB Connect, KBank Live, K PLUS
  bank           String?  // รหัสธนาคาร เช่น SCB, KBANK, KTB, BBL, TTB, GSB
  amount         Float    // จำนวนเงินเข้า (บาท)
  account        String?  // เลขบัญชี เช่น x-1234
  matchedOrderId String?  // รหัสออเดอร์ที่ถูกจับคู่
  matchedTableNo Int?     // โต๊ะที่ถูกจับคู่
  status         String   @default("MATCHED") // MATCHED (ปิดบิลออโต้แล้ว), AMBIGUOUS (มียอดซ้ำหลายโต๊ะ), UNMATCHED (ไม่พบโต๊ะที่ยอดตรง)
  createdAt      DateTime @default(now())

  @@index([storeId, createdAt])
}

// ----------------------------------------------------
// 9. ระบบกระดานสนทนาและข้อเสนอแนะ (Community Board & Forum)
// ----------------------------------------------------

model BoardCategory {
  id          String        @id @default(cuid())
  slug        String        @unique // suggestion, community, feedback, announcement
  name        String
  description String?
  icon        String?       // Lucide icon name or emoji
  sortOrder   Int           @default(0)
  threads     BoardThread[]
  createdAt   DateTime      @default(now())
}

model BoardThread {
  id            String          @id @default(cuid())
  categoryId    String
  category      BoardCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  body          String
  isPinned      Boolean         @default(false)
  isLocked      Boolean         @default(false)
  status        String          @default("VISIBLE") // VISIBLE, HIDDEN, PENDING_REVIEW
  featureStatus String?         // UNDER_REVIEW, IN_PROGRESS, COMPLETED, DECLINED
  viewsCount    Int             @default(0)
  comments      BoardComment[]
  reactions     BoardReaction[]
  reports       BoardReport[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([categoryId, createdAt(sort: Desc)])
}

model BoardComment {
  id        String          @id @default(cuid())
  threadId  String
  thread    BoardThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    BoardComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   BoardComment[]  @relation("CommentReplies")
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  status    String          @default("VISIBLE") // VISIBLE, HIDDEN
  reactions BoardReaction[]
  reports   BoardReport[]
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt(sort: Asc)])
}

model BoardReaction {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId  String?
  thread    BoardThread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  commentId String?
  comment   BoardComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type      String        @default("LIKE") // LIKE, UPVOTE
  createdAt DateTime      @default(now())

  @@unique([userId, threadId, commentId, type])
  @@index([threadId])
  @@index([commentId])
}

model BoardReport {
  id         String        @id @default(cuid())
  reporterId String
  reporter   User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  threadId   String?
  thread     BoardThread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    BoardComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason     String
  status     String        @default("OPEN") // OPEN, REVIEWED, DISMISSED
  createdAt  DateTime      @default(now())
}

// ----------------------------------------------------
// 7. ระบบยืนยันตัวตนผ่าน SMS OTP (SMS OTP Verification)
// ----------------------------------------------------

model SmsOtp {
  id        String   @id @default(cuid())
  phone     String
  otpCode   String
  refCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model LoginAttempt {
  key         String @id
  windowStart BigInt
  count       Int    @default(0)
}


