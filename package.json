{
  "name": "pos-restaurant-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "postinstall": "prisma generate",
    "pages:build": "npx @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion && node scripts/patch-worker.js",
    "deploy": "npm run pages:build && wrangler deploy",
    "cf:build": "npm run build && npx @opennextjs/cloudflare build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pos-restaurant --local",
    "db:migrate:remote": "wrangler d1 migrations apply pos-restaurant --remote"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@formkit/auto-animate": "^0.10.0",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-table": "^8.21.3",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.3.0",
    "graphql": "^17.0.2",
    "hono": "^4.13.13",
    "jose": "^6.2.10",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "pg": "^8.23.0",
    "promptpay-qr": "^0.5.0",
    "qrcode.react": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^2.5.4",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vercel": "^59.10.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.141.0"
  }
}
