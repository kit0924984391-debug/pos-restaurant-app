{
  "name": "pos-restaurant-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "postinstall": "prisma generate",
    "pages:build": "npx @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "deploy": "npm run pages:build && wrangler deploy",
    "cf:build": "npm run build && npx @opennextjs/cloudflare build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.117.2",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "pg": "^8.23.0",
    "promptpay-qr": "^0.5.0",
    "qrcode.react": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vercel": "^59.10.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.141.0"
  }
}
